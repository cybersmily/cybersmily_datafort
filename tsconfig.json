{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "noImplicitAny": false,
    "strict": false,
    "typeRoots": [
      "node_modules/@types"
    ],
    "module": "es2020",
    "useDefineForClassFields": false,    
    "paths": {
      "@app/*":["./src/app/*"]
    }
  }
}
